// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from
// the command palette (ctrl-shift-p).
//
// The theme and icon theme come from the "Tokyo Night" and
// "Material Icon Theme" extensions; both are installed
// automatically through `auto_install_extensions`.
{
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night Moon"
  },
  "icon_theme": "Material Icon Theme",
  "auto_install_extensions": {
    "tokyo-night": true,
    "material-icon-theme": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "inlay_hints": {
    "enabled": true
  },
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "project_panel": {
    "dock": "left",
    "button": true
  },
  "collaboration_panel": {
    "dock": "left"
  }
}
