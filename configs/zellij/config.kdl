// Zellij built-in keybindings plus Kitty-like tab shortcuts.
theme "tokyonight_moon"
default_layout "compact"
default_mode "normal"
show_startup_tips false
// Keep mouse scrolling from opening the compact-bar scroll-mode tooltip.
scroll_mode_sync false

keybinds {
    normal {
        bind "Ctrl Shift t" { NewTab; }
        bind "Ctrl Shift q" { CloseTab; }
        bind "Ctrl Shift Left" { GoToPreviousTab; }
        bind "Ctrl Shift Right" { GoToNextTab; }
    }
}

plugins {
    compact-bar location="zellij:compact-bar" {
        tooltip "F1"
    }
}
