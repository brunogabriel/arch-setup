#!/bin/bash

# arch-setup - Interactive CLI for Manjaro/Arch Linux setup
# Author: Bruno

# Note: set -e removed to allow graceful error handling in loops

# Get installation directory
INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load core utilities
source "$INSTALL_DIR/core/config.sh"
source "$INSTALL_DIR/core/colors.sh"
source "$INSTALL_DIR/core/ui.sh"
source "$INSTALL_DIR/core/logger.sh"
source "$INSTALL_DIR/core/requirements.sh"
source "$INSTALL_DIR/core/user-config.sh"
source "$INSTALL_DIR/core/themes.sh"
source "$INSTALL_DIR/core/install-utils.sh"
source "$INSTALL_DIR/core/run-installers.sh"
source "$INSTALL_DIR/core/zsh-config.sh"
source "$INSTALL_DIR/core/terminal.sh"
source "$INSTALL_DIR/core/desktop.sh"
source "$INSTALL_DIR/core/mise-install.sh"
source "$INSTALL_DIR/core/extras.sh"
source "$INSTALL_DIR/core/install-all.sh"
source "$INSTALL_DIR/core/view-status.sh"
source "$INSTALL_DIR/core/custom-install.sh"
source "$INSTALL_DIR/core/exit.sh"
source "$INSTALL_DIR/core/plugins.sh"

# Menu items — add new entries here only: (title, action function)
MENU_TITLES=(
    "Install All (Terminal + Desktop)"
    "Configure System (Git, User Info)"
    "Install Terminal Tools"
    "Install Desktop Applications"
    "Install Programming Languages (mise)"
    "System / Hardware Extras"
    "Plugins"
    "Custom Install"
    "View Installation Status"
    "Exit"
)
MENU_ACTIONS=(
    "install_all"
    "configure_user"
    "install_terminal_tools"
    "install_desktop_apps"
    "install_programming_language"
    "install_extras"
    "install_plugins"
    "custom_install"
    "view_installation_status"
    "menu_exit"
)

# Main menu
main_menu() {
    while true; do
        clear

        ui_header "ARCH SETUP" "Your system, your setup."
        
        echo ""
        
        local choice
        choice=$(gum choose \
            --cursor '› ' \
            --padding "0 1" \
            --cursor.foreground "$UI_ACCENT" \
            --header.foreground "$UI_SECONDARY" \
            --header "Choose an action · ↑/↓ navigate · Enter select" \
            "${MENU_TITLES[@]}") || return 0
        
        # Dispatch: find the matching title and call its action
        local i
        for i in "${!MENU_TITLES[@]}"; do
            if [ "${MENU_TITLES[$i]}" = "$choice" ]; then
                "${MENU_ACTIONS[$i]}"
                break
            fi
        done
    done
}

# Start
init_logger
check_requirements
main_menu
