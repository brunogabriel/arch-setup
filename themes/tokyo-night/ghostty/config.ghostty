# Tokyo Night Moon
# based on tokyonight-moon (folke), moon variant

background = #222436
foreground = #c8d3f5

selection-background = #2d3f76
selection-foreground = #c8d3f5

cursor-color = #c8d3f5
cursor-text = #222436

# Normal colors
palette = 0=#1b1d2b
palette = 1=#ff757f
palette = 2=#c3e88d
palette = 3=#ffc777
palette = 4=#82aaff
palette = 5=#c099ff
palette = 6=#86e1fc
palette = 7=#828bb8

# Bright colors
palette = 8=#444a73
palette = 9=#ff757f
palette = 10=#c3e88d
palette = 11=#ffc777
palette = 12=#82aaff
palette = 13=#c099ff
palette = 14=#86e1fc
palette = 15=#c8d3f5

# Fonts
font-family = FiraCode Nerd Font
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 11

# Window
#background-opacity = 0.80
background-opacity-cells = true
window-padding-x = 4
window-padding-y = 4
window-padding-color = background
window-padding-balance = true

# Borders / decorations
window-theme = ghostty
window-titlebar-background = #222436
window-titlebar-foreground = #c8d3f5

# Misc
confirm-close-surface = false

keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = ctrl+shift+x=close_surface
